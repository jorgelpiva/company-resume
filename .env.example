# Chave usada exclusivamente pelo backend. Nunca use o prefixo VITE_ para segredos.
GEMINI_API_KEY=replace-with-a-valid-server-side-key

# Opcional: restringe CORS a origens extras, separadas por vírgula.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcional: diretório temporário dos artefatos de um mapeamento.
COMPANY_RESUME_WORK_DIR=/tmp/company-resume
